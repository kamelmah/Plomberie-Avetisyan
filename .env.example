# ─────────────────────────────────────────────────────────────
# E-mail — Resend (obligatoire, sinon le formulaire est refusé)
# ─────────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Expéditeur : doit appartenir à un domaine vérifié dans Resend.
# Tant que le domaine n'est pas vérifié, utilisez onboarding@resend.dev
# (Resend n'acceptera alors la livraison que vers l'adresse du compte).
RESEND_FROM="Site Plomberie Avetisyan <devis@plomberie-avetisyan.fr>"

# Adresse qui reçoit les demandes de devis.
RESEND_TO=contact@plomberie-avetisyan.fr


# ─────────────────────────────────────────────────────────────
# SMS au gérant (facultatif — un échec ne bloque jamais l'e-mail)
# ─────────────────────────────────────────────────────────────
# Numéro destinataire, format E.164.
SMS_TO=+33660600500

# Option A — Brevo (retenue par défaut si BREVO_API_KEY est défini).
# https://app.brevo.com/settings/keys/api  ·  expéditeur alphanumérique
# à faire déclarer auprès de Brevo pour la France (11 caractères max).
BREVO_API_KEY=
BREVO_SMS_SENDER=Plomberie

# Option B — Twilio (utilisée si Brevo n'est pas configuré).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+33XXXXXXXXX


# ─────────────────────────────────────────────────────────────
# Photos jointes — Supabase Storage (facultatif)
# Sans ces variables, le champ photo renvoie une erreur claire
# et la demande peut être envoyée sans photo.
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé service_role : SECRÈTE. Ne jamais la préfixer VITE_, elle ne doit
# jamais atteindre le navigateur. Le client ne reçoit que des URL signées.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket PRIVÉ. Réglez sa limite de taille à 5 Mo et restreignez les types
# MIME aux images : c'est là que la contrainte est réellement appliquée.
SUPABASE_BUCKET=devis-photos
